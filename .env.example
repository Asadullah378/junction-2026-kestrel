# Kestrel. Copy to .env.local and fill in. Never commit real values.
# Add each new variable here with an empty value when you introduce it.
# The app in web/ reads this file at startup (see web/next.config.ts).

# Context.dev: search with page text, page reads, news, the Maps parser and monitors.
# Get a key at https://context.dev/dashboard
CONTEXT_DEV_API_KEY=
# Oxylabs Web API: search from a country, pages that need a browser, AI Parsing, Google Shopping.
# Create a Web API instance at https://dashboard.oxylabs.io and copy its key.
OXYLABS_WEB_API_KEY=

# Claude, through Claude Platform on AWS (Anthropic-operated; not Amazon Bedrock).
# An API key from the AWS console for that service, the workspace it belongs to, and its region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=

# Gemini, through Google AI Studio. Get a key at https://aistudio.google.com/apikey
# It runs two of the four modes, the decision model that Sift and watches judge with, and voice.
GOOGLE_API_KEY=
# The voice the agent speaks with in a live call. Optional (default: Sulafat). Any of Gemini's voice names.
KESTREL_VOICE=

# Accounts and the database. Required: without them nobody can sign in.
# A Postgres database for accounts, sign-ins, conversations, watches and usage. The server creates
# and updates its tables itself when it starts (or run `pnpm db:migrate`). Local example:
# postgres://localhost:5432/kestrel   Hosted example: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# The one admin account. It is created when the server starts, and its password follows this
# value: change it here and restart. Every other account is created by the admin, under /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The name shown for the admin. Optional (default: Admin).
ADMIN_NAME=

# The site's public address, for link previews, for the links in emails, and for the address
# Context.dev's monitors call when a watched page changes (<address>/api/hooks/context).
# Monitors are not registered while this is empty or points at localhost.
# (https://kestrel.zeroanomaly.tech in production, which is also what is used when this is empty).
KESTREL_SITE_URL=
# The demo film shown on the landing page: a YouTube link, or the address of a video file, or
# /landing/demo.mp4 for a local copy put in web/public/landing (kept out of git).
# Empty shows "The demo video is on its way".
KESTREL_DEMO_VIDEO=

# Email: notices and what a watch found go out through Resend (resend.com).
# Without the key nothing is sent and everything else still works: notices show in the app only.
RESEND_API_KEY=
# The sender. It must be an address on a domain verified at Resend. Optional.
KESTREL_EMAIL_FROM=

# ElevenLabs (elevenlabs.io): the voiceover and music of the demo film in video/. The app does not use it.
ELEVENLABS_API_KEY=
